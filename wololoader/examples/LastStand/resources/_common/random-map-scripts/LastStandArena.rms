/* ************ LAST STAND ARENA ************ */
/* Map of the Last Stand game mode (Wololoader example mod). The game mode picks it by itself.  */
/* Every player starts close to the map centre, where the Last Stand script puts the shared     */
/* Castle: the player lands may only be placed inside the middle of the map (the big borders    */
/* below, in percent of the map), so the Town Centers end on a small ring around the centre.    */
/* An empty central land keeps the Castle spot free. The Horde comes from the open plains and   */
/* forests around the ring.                                                                     */

<PLAYER_SETUP>
  random_placement

<LAND_GENERATION>
base_terrain GRASS

/* the Castle spot: a small clear land in the exact middle */
create_land
{
  terrain_type                  DIRT
  land_percent                  1
  base_size                     5
  land_position                 50 50
  border_fuzziness              15
  other_zone_avoidance_distance 4
}

create_player_lands
{
  terrain_type                  GRASS3
  land_percent                  20
  base_size                     8
/* borders in percent of the map: the middle area left for the players stays about 40 tiles wide on
   every map size (Tiny 120, Small 144, Medium 168, Normal 200, Large 220, Giant 240, LudiKRIS 480) */
if TINY_MAP
  left_border                  33
  right_border                 33
  top_border                   33
  bottom_border                33
elseif SMALL_MAP
  left_border                  36
  right_border                 36
  top_border                   36
  bottom_border                36
elseif MEDIUM_MAP
  left_border                  38
  right_border                 38
  top_border                   38
  bottom_border                38
elseif LARGE_MAP
  left_border                  40
  right_border                 40
  top_border                   40
  bottom_border                40
elseif HUGE_MAP
  left_border                  41
  right_border                 41
  top_border                   41
  bottom_border                41
elseif GIGANTIC_MAP
  left_border                  42
  right_border                 42
  top_border                   42
  bottom_border                42
else
  left_border                  46
  right_border                 46
  top_border                   46
  bottom_border                46
endif
  border_fuzziness              5
  other_zone_avoidance_distance 2
}

<TERRAIN_GENERATION>

/* forests outside the ring: cover for the Horde, wood for the players, with gaps between clumps */
create_terrain FOREST
{
  base_terrain                  GRASS
  spacing_to_other_terrain_types 6
  land_percent                  12
  number_of_clumps              14
  set_avoid_player_start_areas
  set_scale_by_groups
}

/* secondary pine groves farther out for woodland variety */
create_terrain PINE_FOREST
{
  base_terrain                  GRASS
  spacing_to_other_terrain_types 5
  land_percent                  4
  number_of_clumps              8
  set_avoid_player_start_areas
  set_scale_by_groups
}

/* small ponds and shallow pools in the outer plains */
create_terrain WATER
{
  base_terrain                  GRASS
  spacing_to_other_terrain_types 4
  land_percent                  1
  number_of_clumps              2
  set_avoid_player_start_areas
  set_flat_terrain_only
  set_scale_by_groups
}

create_terrain SHALLOW
{
  base_terrain                  GRASS
  spacing_to_other_terrain_types 3
  land_percent                  1
  number_of_clumps              3
  set_avoid_player_start_areas
  set_flat_terrain_only
  set_scale_by_groups
}

/* dirt, grass, leaf and worn road patches across the outer battlefield */
create_terrain DIRT3
{
  base_terrain                  GRASS
  number_of_clumps              18
  spacing_to_other_terrain_types 1
  land_percent                  4
  set_scale_by_size
}

create_terrain DIRT2
{
  base_terrain                  GRASS
  number_of_clumps              14
  spacing_to_other_terrain_types 1
  land_percent                  3
  set_scale_by_size
}

create_terrain GRASS2
{
  base_terrain                  GRASS
  number_of_clumps              20
  spacing_to_other_terrain_types 1
  land_percent                  4
  set_scale_by_size
}

create_terrain LEAVES
{
  base_terrain                  GRASS
  number_of_clumps              18
  spacing_to_other_terrain_types 1
  land_percent                  3
  set_scale_by_size
}

create_terrain ROAD2
{
  base_terrain                  GRASS
  number_of_clumps              8
  spacing_to_other_terrain_types 1
  land_percent                  1
  set_avoid_player_start_areas
  set_scale_by_size
}

