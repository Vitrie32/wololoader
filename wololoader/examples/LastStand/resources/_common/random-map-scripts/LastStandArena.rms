<ELEVATION_GENERATION>

/* rolling hills across the outer grass plains, keeping the centre and player ring flat */
create_elevation 4
{
  base_terrain                  GRASS
  number_of_clumps              12
  number_of_tiles               800
  set_scale_by_groups
  set_scale_by_size
}

/* a few higher hills in the outer ring that defenders can push out and hold */
create_elevation 7
{
  base_terrain                  GRASS
  number_of_clumps              5
  number_of_tiles               400
  set_scale_by_groups
  set_scale_by_size
}

<CLIFF_GENERATION>

/* well-spaced cliffs in the outer area creating natural choke points without sealing paths */
if TINY_MAP
  min_number_of_cliffs          3
  max_number_of_cliffs          5
  min_length_of_cliff           3
  max_length_of_cliff           6
elseif SMALL_MAP
  min_number_of_cliffs          4
  max_number_of_cliffs          6
  min_length_of_cliff           3
  max_length_of_cliff           7
elseif MEDIUM_MAP
  min_number_of_cliffs          5
  max_number_of_cliffs          8
  min_length_of_cliff           4
  max_length_of_cliff           8
elseif LARGE_MAP
  min_number_of_cliffs          6
  max_number_of_cliffs          9
  min_length_of_cliff           4
  max_length_of_cliff           8
elseif HUGE_MAP
  min_number_of_cliffs          8
  max_number_of_cliffs          11
  min_length_of_cliff           4
  max_length_of_cliff           9
elseif GIGANTIC_MAP
  min_number_of_cliffs          9
  max_number_of_cliffs          12
  min_length_of_cliff           4
  max_length_of_cliff           9
else
  min_number_of_cliffs          16
  max_number_of_cliffs          24
  min_length_of_cliff           5
  max_length_of_cliff           12
endif
  cliff_curliness               10
  min_distance_cliffs           5

<CONNECTION_GENERATION>

/* narrow roads linking the player ring around the Castle pad and keeping approaches open */
create_connect_all_players_land
{
  replace_terrain WATER         SHALLOW
  replace_terrain FOREST        ROAD2
  replace_terrain PINE_FOREST   ROAD2
  replace_terrain GRASS         ROAD2
  terrain_cost    WATER         7
  terrain_cost    SHALLOW       3
  terrain_cost    FOREST        7
  terrain_cost    PINE_FOREST   7
  terrain_cost    DIRT          15
  terrain_cost    GRASS         2
  terrain_cost    GRASS2        2
  terrain_cost    GRASS3        2
  terrain_cost    DIRT2         2
  terrain_cost    DIRT3         2
  terrain_cost    LEAVES        2
  terrain_cost    ROAD2         1
  terrain_size    WATER         2       1
  terrain_size    FOREST        2       1
  terrain_size    PINE_FOREST   2       1
  terrain_size    GRASS         1       0
  terrain_size    GRASS2        0       0
  terrain_size    GRASS3        0       0
  terrain_size    DIRT          0       0
  terrain_size    DIRT2         0       0
  terrain_size    DIRT3         0       0
  terrain_size    LEAVES        0       0
  terrain_size    ROAD2         0       0
}
