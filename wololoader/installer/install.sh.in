#!/bin/sh
# Wololoader @VERSION@ setup for Linux (Steam + Proton, or Wine).
#
#   sh wololoader-linux-setup.sh [game folder] [--no-examples] [--uninstall] [--yes]
#
# Copies version.dll and the wololoader folder into the Age of Empires II HD folder (the one with
# "AoK HD.exe"). Existing mod.json files are kept (they hold your mod on/off switches).
# The files are in a tar.gz after the __PAYLOAD__ line at the end of this script.
set -eu

VERSION="@VERSION@"
GAME=""
EXAMPLES=1
UNINSTALL=0
YES=0
for a in "$@"; do
    case "$a" in
        --no-examples) EXAMPLES=0 ;;
        --uninstall) UNINSTALL=1 ;;
        --yes|-y) YES=1 ;;
        -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "Unknown option: $a" >&2; exit 2 ;;
        *) GAME="$a" ;;
    esac
done

say() { printf '%s\n' "$*"; }
ask() {  # ask "question" -> 0 for yes
    [ "$YES" = 1 ] && return 0
    printf '%s [y/N] ' "$1"
    read -r ans || return 1
    case "$ans" in y|Y|yes|Yes|e|E|evet) return 0 ;; *) return 1 ;; esac
}
is_game() { [ -n "$1" ] && [ -f "$1/AoK HD.exe" ]; }

# Steam libraries: <steam>/steamapps/libraryfolders.vdf lists them; the game's folder name is the
# "installdir" in appmanifest_221380.acf (app 221380 = Age of Empires II HD).
find_game() {
    for steam in "$HOME/.steam/steam" "$HOME/.local/share/Steam" \
                 "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam" "$HOME/snap/steam/common/.local/share/Steam"; do
        vdf="$steam/steamapps/libraryfolders.vdf"
        libs="$steam"
        [ -f "$vdf" ] && libs="$libs
$(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$vdf" | sed 's/\\\\/\\/g')"
        printf '%s\n' "$libs" | while IFS= read -r lib; do
            [ -n "$lib" ] || continue
            dir="Age2HD"
            acf="$lib/steamapps/appmanifest_221380.acf"
            [ -f "$acf" ] && dir=$(sed -n 's/^[[:space:]]*"installdir"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$acf" | head -n 1)
            if is_game "$lib/steamapps/common/$dir"; then printf '%s\n' "$lib/steamapps/common/$dir"; break; fi
        done
    done | head -n 1
}

say "Wololoader $VERSION setup (Age of Empires II HD 5.8)"
if [ -z "$GAME" ]; then
    GAME=$(find_game || true)
    if [ -n "$GAME" ]; then
        say "Found the game: $GAME"
        ask "Use this folder?" || GAME=""
    fi
fi
while ! is_game "$GAME"; do
    [ -n "$GAME" ] && say "No \"AoK HD.exe\" in: $GAME"
    [ "$YES" = 1 ] && { say "Pass the game folder as an argument." >&2; exit 1; }
    say "Game folder (Steam: right-click the game > Manage > Browse local files; drag it here):"
    read -r GAME || exit 1
    GAME=$(printf '%s' "$GAME" | sed "s/^[[:space:]]*['\"]\{0,1\}//; s/['\"]\{0,1\}[[:space:]]*\$//; s|^file://||; s|/*\$||")
done

# Wine names the process after the exe (comm, 15 chars max: "AoK HD.exe" fits)
if pgrep -x "AoK HD.exe" >/dev/null 2>&1; then
    say "Age of Empires II HD is running. Close it first." >&2
    exit 1
fi

if [ "$UNINSTALL" = 1 ]; then
    ask "Delete $GAME/version.dll and $GAME/wololoader (with all mods in it)?" || exit 1
    rm -f "$GAME/version.dll"
    rm -rf "$GAME/wololoader"
    say "Uninstalled. You can remove WINEDLLOVERRIDES=\"version=n,b\" from the game's launch options."
    exit 0
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
line=$(awk '/^__PAYLOAD__$/ { print NR + 1; exit }' "$0")
tail -n +"$line" "$0" | tar -xzf - -C "$TMP"

copy_tree() {  # copy_tree <src> : into $GAME, keeping existing mod.json
    (cd "$1" && find . -type f) | while IFS= read -r f; do
        f=${f#./}
        if [ "$(basename "$f")" = "mod.json" ] && [ -f "$GAME/$f" ]; then continue; fi
        mkdir -p "$GAME/$(dirname "$f")"
        cp "$1/$f" "$GAME/$f"
    done
}
copy_tree "$TMP/core"
[ "$EXAMPLES" = 1 ] && copy_tree "$TMP/examples"

say ""
say "Installed into: $GAME"
say ""
say "One more step, so the game loads Wololoader under Proton/Wine:"
say "  Steam > right-click Age of Empires II HD > Properties > Launch Options, put:"
say ""
say "    WINEDLLOVERRIDES=\"version=n,b\" %command%"
say ""
say "(Wine/Lutris: set the environment variable WINEDLLOVERRIDES=version=n,b.)"
say "Then start the game: the main menu shows \"Wololoader $VERSION\"."
exit 0
__PAYLOAD__
